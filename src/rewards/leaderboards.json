{
  "$comment": "What each game reports and how its leaderboard ranks. better: higher or lower. min/max reject impossible values; integer rejects fractions. kind: best (one best value per player) or count (how many times the player logged countEvent). events lists everything a game may report; anything else is refused. All of these are reported by the player's browser, so the board shows them as self-reported until a game validates its results on the server.",
  "games": [
    { "id": "pc-tetris", "label": "Tetris (PC)", "events": ["launch", "game-over"],
      "metrics": [
        { "id": "score", "label": "High score", "better": "higher", "min": 0, "max": 9999999, "integer": true, "kind": "best" },
        { "id": "lines", "label": "Most lines", "better": "higher", "min": 0, "max": 9999, "integer": true, "kind": "best" },
        { "id": "level", "label": "Highest level", "better": "higher", "min": 1, "max": 99, "integer": true, "kind": "best" }
      ] },
    { "id": "pc-minesweeper", "label": "Minesweeper", "events": ["launch", "won", "won-expert", "lost"], "modes": ["beginner", "intermediate", "expert"],
      "metrics": [
        { "id": "time", "label": "Fastest clear", "unit": "s", "better": "lower", "min": 1, "max": 999, "integer": true, "kind": "best" }
      ] },
    { "id": "pc-solitaire", "label": "Solitaire", "events": ["launch", "won"],
      "metrics": [
        { "id": "score", "label": "Best score", "better": "higher", "min": 0, "max": 100000, "integer": true, "kind": "best" },
        { "id": "wins", "label": "Wins", "better": "higher", "kind": "count", "countEvent": "won" }
      ] },
