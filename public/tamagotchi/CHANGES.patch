diff --git a/src/experience/camera.js b/src/experience/camera.js
index c1b0a03..fbdb8df 100644
--- a/src/experience/camera.js
+++ b/src/experience/camera.js
@@ -58,9 +58,22 @@ export default class Camera {
     this.controls.restThreshold = 0.25
   }
 
+  // On a tall screen pull back just enough to fit the whole device (and,
+  // before it is switched on, the battery strip beside it) across the width.
+  fit() {
+    const aspect = this.sizes.aspectRatio
+    const halfWidth = Math.tan((this.instance.fov * Math.PI) / 360) * 3 * aspect
+    const unstarted = !this.experience.life.started && aspect < 1
+    const need = unstarted ? 1.3 : 0.9
+    this.controls.zoomTo(aspect < 1 ? Math.min(1, halfWidth / need) : 1, true)
+    this.controls.setFocalOffset(unstarted ? 0.3 : 0, 0, 0, true)
+  }
+
   resize() {
     this.instance.aspect = this.sizes.aspectRatio
     this.instance.updateProjectionMatrix()
+    // Turning the phone refits the device, unless something else is framing it.
+    if (this.controls.enabled && this.experience.life) this.fit()
 
     this.debug?.refresh()
   }
@@ -76,11 +89,7 @@ export default class Camera {
   async intro(speed = 1.5) {
     this.controls.enabled = false
     this.controls.smoothTime = speed
-    this.controls.zoomTo(1, true)
